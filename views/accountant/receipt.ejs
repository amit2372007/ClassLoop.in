<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fee Receipt - <%= transaction.transactionId || transaction._id %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <style>
    body { font-family: 'Inter', sans-serif; }
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen py-8 px-4 flex flex-col items-center">

  <!-- Action Bar (Hidden during printing) -->
  <div class="no-print mb-6 w-full max-w-2xl flex justify-between items-center bg-white px-5 py-3 rounded-xl shadow-sm border border-slate-200">
    <a href="/accountant?tab=FeeCounter" class="text-slate-600 hover:text-slate-900 font-medium text-xs flex items-center gap-1">
      <span class="material-symbols-outlined text-sm">arrow_back</span> Back to Dashboard
    </a>
    <div class="flex items-center gap-3">
      <button onclick="window.print()" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm transition-all">
        <span class="material-symbols-outlined text-base">print</span> Print Receipt
      </button>
      <button onclick="window.print()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm transition-all">
        <span class="material-symbols-outlined text-base">download</span> Save as PDF
      </button>
    </div>
  </div>

  <!-- Printable Receipt Card -->
  <div class="w-full max-w-2xl bg-white border border-slate-200 rounded-2xl shadow-xl p-8 relative overflow-hidden">
    
    <!-- Watermark Status -->
    <div class="absolute right-8 top-12 opacity-5 pointer-events-none">
      <span class="text-8xl font-black uppercase text-emerald-600 tracking-widest"><%= transaction.status %></span>
    </div>

    <!-- School Header -->
    <div class="text-center border-b border-slate-200 pb-5">
      <h1 class="text-xl font-bold text-slate-900 tracking-tight"><%= school?.name || 'ClassLoop Academy & Institution' %></h1>
      <p class="text-xs text-slate-500 mt-0.5"><%= school?.address || 'Official Fee Collection & Accounting Desk' %></p>
      <div class="inline-block mt-2 bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider">
        Fee Payment Receipt
      </div>
    </div>

    <!-- Receipt Meta & Student Info Grid -->
    <div class="grid grid-cols-2 gap-6 my-6 text-xs">
      <!-- Left: Student Details -->
      <div class="space-y-1.5 bg-slate-50 p-3.5 rounded-xl border border-slate-100">
        <p class="text-slate-400 font-bold uppercase tracking-wider text-[10px]">Student Details</p>
        <p class="font-bold text-slate-900 text-sm"><%= transaction.student?.name || 'N/A' %></p>
        <p class="text-slate-600"><span class="font-semibold">Adm No:</span> <%= transaction.student?.admissionNumber || 'N/A' %></p>
        <p class="text-slate-600"><span class="font-semibold">Class:</span> <%= transaction.student?.instituition?.class?.className || 'N/A' %> <%= transaction.student?.instituition?.class?.section || '' %></p>
      </div>

      <!-- Right: Receipt Meta -->
      <div class="space-y-1.5 bg-slate-50 p-3.5 rounded-xl border border-slate-100 text-right">
        <p class="text-slate-400 font-bold uppercase tracking-wider text-[10px]">Transaction Meta</p>
        <p class="font-mono text-slate-900 font-bold"><%= transaction.transactionId || transaction._id.toString().toUpperCase() %></p>
        <p class="text-slate-600"><span class="font-semibold">Date:</span> <%= new Date(transaction.date || transaction.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
        <p class="text-slate-600"><span class="font-semibold">Mode:</span> <span class="text-emerald-700 font-bold"><%= transaction.paymentMethod %></span></p>
      </div>
    </div>

    <!-- Fee Items Ledger Table -->
    <div class="mb-6">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 text-slate-400 text-[10px] uppercase tracking-wider">
            <th class="py-2.5 font-bold">Fee Particular / Month</th>
            <th class="py-2.5 font-bold text-center">Status</th>
            <th class="py-2.5 font-bold text-right">Amount (INR)</th>
          </tr>
        </thead>
        <tbody class="text-xs divide-y divide-slate-100 text-slate-700">
          <tr>
            <td class="py-3 font-medium">
              Tuition & Academic Fee (<%= transaction.feeRecord?.month || 'General' %> <%= transaction.feeRecord?.year || '' %>)
              <% if (transaction.feeRecord?.feeHead) { %>
                <span class="block text-[10px] text-slate-400"><%= transaction.feeRecord.feeHead %></span>
              <% } %>
            </td>
            <td class="py-3 text-center">
              <span class="bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded text-[10px]">PAID</span>
            </td>
            <td class="py-3 text-right font-mono font-semibold">₹<%= (transaction.amount || 0).toLocaleString('en-IN') %></td>
          </tr>
          <% if (transaction.feeRecord?.fine > 0) { %>
            <tr>
              <td class="py-3 font-medium text-amber-700">Late Fine / Penalty</td>
              <td class="py-3 text-center">-</td>
              <td class="py-3 text-right font-mono font-semibold text-amber-700">₹<%= transaction.feeRecord.fine.toLocaleString('en-IN') %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Totals & Summary Box -->
    <div class="border-t border-slate-200 pt-4 flex justify-between items-end">
      <div>
        <p class="text-[11px] text-slate-500 font-medium">Remarks: <span class="italic text-slate-700"><%= transaction.remarks || 'Standard fee desk clearance' %></span></p>
        <p class="text-[11px] text-slate-500 font-medium mt-1">Collected By: <span class="font-semibold text-slate-700"><%= transaction.collectedBy?.name || 'Authorized Accountant' %></span></p>
      </div>
      <div class="bg-slate-900 text-white px-5 py-3 rounded-xl text-right min-w-[200px]">
        <p class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Total Paid Amount</p>
        <p class="text-xl font-extrabold text-emerald-400 font-mono mt-0.5">₹<%= (transaction.amount || 0).toLocaleString('en-IN') %></p>
      </div>
    </div>

    <!-- Footer Signatures -->
    <div class="mt-16 pt-8 border-t border-dashed border-slate-200 flex justify-between text-xs text-slate-500">
      <div class="text-center">
        <div class="w-36 border-b border-slate-400 mb-1"></div>
        <p class="font-medium">Depositor Signature</p>
      </div>
      <div class="text-center">
        <div class="w-36 border-b border-slate-400 mb-1"></div>
        <p class="font-medium">Authorized Accountant Sign</p>
      </div>
    </div>

    <!-- System Generated Footer -->
    <div class="text-center mt-8 text-[10px] text-slate-400">
      <p>This is a computer-generated official fee receipt from ClassLoop.in Academic ERP.</p>
    </div>

  </div>

</body>
</html>