<!DOCTYPE html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= student.name %> | Student Profile | ClassLoop.in</title>

    <!-- Fonts & Icons -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    />

    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Tailwind Config -->
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#4848e5",
              "background-light": "#f6f6f8",
              "background-dark": "#111121",
            },
            fontFamily: {
              display: ["Inter", "sans-serif"],
            },
            borderRadius: {
              DEFAULT: "0.5rem",
              lg: "1rem",
              xl: "1.5rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <style>
      body {
        font-family: "Inter", sans-serif;
      }
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
      }
      .material-symbols-outlined.filled {
        font-variation-settings: "FILL" 1;
      }

      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 4px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
      }
      .dark .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #334155;
      }

      /* Modal Animations */
      @keyframes modalFadeIn {
        from {
          opacity: 0;
          transform: scale(0.95);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      .modal-active {
        animation: modalFadeIn 0.2s ease-out forwards;
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 transition-colors duration-200 min-h-screen"
  >
    <!-- Top Navigation Bar -->
    <nav
      class="bg-white dark:bg-[#1a1a2e] border-b border-slate-200 dark:border-slate-800 px-6 py-4 flex justify-between items-center sticky top-0 z-10"
    >
      <div class="flex items-center gap-4">
        <button
          onclick="window.history.back()"
          class="p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors flex items-center gap-2 text-slate-600 dark:text-slate-300"
        >
          <span class="material-symbols-outlined">arrow_back</span>
          <span class="font-medium hidden sm:block">Back to Class</span>
        </button>
      </div>
      <div class="text-lg font-bold text-primary">
        ClassLoop<span class="text-slate-900 dark:text-white">.in</span>
      </div>
    </nav>

    <!-- ==================== FLASH MESSAGES SECTION ==================== -->
    <div id="flash-container" class="max-w-7xl mx-auto px-4 sm:px-6 mt-6 z-50">
      <!-- Success Alert -->
      <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="flex items-center justify-between p-4 mb-4 text-sm text-emerald-800 bg-emerald-50 dark:bg-emerald-500/10 dark:text-emerald-400 rounded-xl border border-emerald-200 dark:border-emerald-500/20 shadow-sm transition-opacity duration-300">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-500">check_circle</span>
            <span class="font-medium"><%= success %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 transition-colors">
            <span class="material-symbols-outlined text-lg">close</span>
          </button>
        </div>
      <% } %>

      <!-- Error Alert -->
      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="flex items-center justify-between p-4 mb-4 text-sm text-rose-800 bg-rose-50 dark:bg-rose-500/10 dark:text-rose-400 rounded-xl border border-rose-200 dark:border-rose-500/20 shadow-sm transition-opacity duration-300">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-rose-500">error</span>
            <span class="font-medium"><%= error %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 transition-colors">
            <span class="material-symbols-outlined text-lg">close</span>
          </button>
        </div>
      <% } %>
    </div>
    <!-- =============================================================== -->

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
      <!-- Profile Header & Actions Bar -->
      <div
        class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8 bg-white dark:bg-[#1a1a2e] p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm"
      >
        <!-- Student Identity -->
        <div class="flex items-center gap-5">
          <div class="relative">
            <img
              src="<%= (student.profilePic && student.profilePic.url) ? student.profilePic.url : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(student.name || 'Student') + '&background=4848e5&color=fff&size=100' %>"
              alt="<%= student.name %>"
              class="w-20 h-20 rounded-full border-4 border-slate-100 dark:border-slate-800 object-cover"
            />
            <span
              id="status-indicator"
              class="absolute bottom-1 right-1 w-4 h-4 <%= student.isSuspended ? 'bg-rose-500' : 'bg-emerald-500' %> border-2 border-white dark:border-[#1a1a2e] rounded-full"
              title="<%= student.isSuspended ? 'Suspended' : 'Active' %>"
            ></span>
          </div>
          <div>
            <div class="flex items-center gap-3">
              <h1 class="text-2xl font-bold text-slate-900 dark:text-white">
                <%= student.name %>
              </h1>
              <span
                id="status-badge"
                class="<%= student.isSuspended ? 'bg-rose-100 text-rose-700 dark:bg-rose-500/20 dark:text-rose-400' : 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-400' %> text-xs font-bold px-2 py-0.5 rounded-full"
              >
                <%= student.isSuspended ? 'Suspended' : 'Active' %>
              </span>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
              Admission No: <%= student.admissionNumber || 'N/A' %> • Class: <%= currClass ? currClass.className : 'Assigned Class' %>
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Username: <%= student.username %>
            </p>
          </div>
        </div>

        <!-- Teacher Actions -->
        <div class="flex flex-wrap items-center gap-2.5">
          <!-- 1. Edit Profile Button -->
          <button
            onclick="openDrawer('editProfileDrawer')"
            class="flex items-center gap-1.5 px-3.5 py-2 bg-primary/10 hover:bg-primary/20 text-primary dark:bg-primary/20 dark:hover:bg-primary/30 font-semibold rounded-lg transition-colors text-xs sm:text-sm"
          >
            <span class="material-symbols-outlined text-base">edit</span>
            Edit Profile
          </button>

          <!-- 2. Reset Password Button -->
          <button
            onclick="openModal('resetPasswordModal')"
            class="flex items-center gap-1.5 px-3.5 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold rounded-lg transition-colors text-xs sm:text-sm"
          >
            <span class="material-symbols-outlined text-base">lock_reset</span>
            Reset Password
          </button>

          <!-- 3. Suspend Student Button -->
          <button
            id="suspendBtn"
            onclick="openModal('suspendModal')"
            class="flex items-center gap-1.5 px-3.5 py-2 bg-amber-50 hover:bg-amber-100 dark:bg-amber-500/10 dark:hover:bg-amber-500/20 text-amber-700 dark:text-amber-400 font-semibold rounded-lg transition-colors text-xs sm:text-sm border border-amber-200 dark:border-amber-500/20"
          >
            <span class="material-symbols-outlined text-base">block</span>
            <%= student.isSuspended ? 'Unsuspend' : 'Suspend' %>
          </button>

          <!-- 4. Delete Student Button -->
          <button
            onclick="openModal('deleteStudentModal')"
            class="flex items-center gap-1.5 px-3.5 py-2 bg-rose-50 hover:bg-rose-100 dark:bg-rose-500/10 dark:hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 font-semibold rounded-lg transition-colors text-xs sm:text-sm border border-rose-200 dark:border-rose-500/20"
          >
            <span class="material-symbols-outlined text-base">delete</span>
            Delete
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column: Details & Finances -->
        <div class="space-y-6">
          <!-- Basic Details Card -->
          <div
            class="bg-white dark:bg-[#1a1a2e] rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm"
          >
            <h3
              class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2"
            >
              <span class="material-symbols-outlined text-primary">person</span>
              Basic Details
            </h3>
            <div class="space-y-4 text-sm">
              <div class="grid grid-cols-3">
                <span class="text-slate-500 dark:text-slate-400">Full Name</span>
                <span class="col-span-2 font-medium text-slate-900 dark:text-white"><%= student.name %></span>
              </div>
              <div class="grid grid-cols-3">
                <span class="text-slate-500 dark:text-slate-400">Phone</span>
                <span class="col-span-2 font-medium text-slate-900 dark:text-white">+91 <%= student.phone %></span>
              </div>
              <div class="grid grid-cols-3">
                <span class="text-slate-500 dark:text-slate-400">Admission No</span>
                <span class="col-span-2 font-medium text-slate-900 dark:text-white"><%= student.admissionNumber || 'Not assigned' %></span>
              </div>
              <div class="grid grid-cols-3">
                <span class="text-slate-500 dark:text-slate-400">Location</span>
                <span class="col-span-2 font-medium text-slate-900 dark:text-white"><%= student.location || 'Not specified' %></span>
              </div>
              <hr class="border-slate-100 dark:border-slate-800" />
              <div class="grid grid-cols-3">
                <span class="text-slate-500 dark:text-slate-400">Verification</span>
                <span class="col-span-2 font-medium">
                  <span class="<%= student.isVerified ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400' %> font-bold">
                    <%= student.isVerified ? 'Verified Student' : 'Pending Verification' %>
                  </span>
                </span>
              </div>
              <div class="grid grid-cols-3">
                <span class="text-slate-500 dark:text-slate-400">Joined On</span>
                <span class="col-span-2 font-medium text-slate-900 dark:text-white">
                  <%= student.createdAt ? new Date(student.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'N/A' %>
                </span>
              </div>
            </div>
          </div>

          <!-- Fees & Transport Card -->
          <div
            class="bg-white dark:bg-[#1a1a2e] rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm"
          >
            <h3
              class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2"
            >
              <span class="material-symbols-outlined text-primary">account_balance_wallet</span>
              Facility & Dues
            </h3>

            <div
              class="p-4 bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 rounded-lg mb-4 flex justify-between items-center"
            >
              <div>
                <p
                  class="text-xs font-semibold text-amber-700 dark:text-amber-400 uppercase tracking-wide"
                >
                  Pending Fees
                </p>
                <p class="text-xl font-bold text-amber-900 dark:text-amber-300">
                  ₹ <%= student.pendingFees || '0' %>
                </p>
              </div>
              <span class="material-symbols-outlined text-amber-500 text-3xl">warning</span>
            </div>

            <div
              class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg flex items-center gap-4"
            >
              <div
                class="w-10 h-10 bg-indigo-100 dark:bg-indigo-500/20 text-primary rounded-full flex items-center justify-center shrink-0"
              >
                <span class="material-symbols-outlined">directions_bus</span>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900 dark:text-white">
                  Transport Facility
                </p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                  <%= student.transportRoute || 'No Transport Registered' %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Calendar, Academics, Exam Records, & Assignments -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Attendance Calendar View -->
          <div class="bg-white dark:bg-[#1a1a2e] rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
            <div class="flex items-center justify-between mb-6">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">calendar_month</span>
                Attendance Record
              </h3>
              <!-- Month Display -->
              <div class="flex items-center gap-3">
                <button class="p-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded text-slate-600 dark:text-slate-300">
                  <span class="material-symbols-outlined text-sm">chevron_left</span>
                </button>
                <span class="text-sm font-bold w-32 text-center" id="calendar-month-display">
                  <%= new Date().toLocaleString('default', { month: 'long', year: 'numeric' }) %>
                </span>
                <button class="p-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded text-slate-600 dark:text-slate-300">
                  <span class="material-symbols-outlined text-sm">chevron_right</span>
                </button>
              </div>
            </div>

            <!-- Legend -->
            <div class="flex flex-wrap gap-4 mb-4 text-xs font-medium">
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded bg-emerald-500"></span> Present
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded bg-rose-500"></span> Absent
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded bg-amber-400"></span> Leave
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded bg-slate-100 dark:bg-slate-700 border border-slate-300 dark:border-slate-600"></span>
                Holiday / Unmarked
              </div>
            </div>

            <!-- Calendar Grid -->
            <div class="w-full">
              <div class="grid grid-cols-7 text-center mb-2">
                <div class="text-xs font-bold text-slate-400 py-2">Sun</div>
                <div class="text-xs font-bold text-slate-400 py-2">Mon</div>
                <div class="text-xs font-bold text-slate-400 py-2">Tue</div>
                <div class="text-xs font-bold text-slate-400 py-2">Wed</div>
                <div class="text-xs font-bold text-slate-400 py-2">Thu</div>
                <div class="text-xs font-bold text-slate-400 py-2">Fri</div>
                <div class="text-xs font-bold text-slate-400 py-2">Sat</div>
              </div>
              <div id="calendar-body" class="grid grid-cols-7 gap-y-2 text-sm font-medium">
                <!-- Days dynamically injected via JS below -->
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-sm">
              <span class="text-slate-500">Current Month Attendance:</span>
              <span class="font-bold text-primary text-lg"><%= typeof attendancePercentage !== 'undefined' ? attendancePercentage : 0 %>%</span>
            </div>
          </div>

          <!-- Quick Academic Overview Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Assignment Progress Card -->
            <div class="bg-white dark:bg-[#1a1a2e] rounded-xl border border-slate-200 dark:border-slate-800 p-5 flex items-center gap-4 shadow-sm">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0">
                <span class="material-symbols-outlined text-2xl">assignment_turned_in</span>
              </div>
              <div>
                <p class="text-xs text-slate-500 font-medium">Assignments Submitted</p>
                <p class="text-lg font-bold text-slate-900 dark:text-white">
                  <%= typeof totalSubmittedAssignments !== 'undefined' ? totalSubmittedAssignments : 0 %> / <%= typeof totalAssignment !== 'undefined' ? totalAssignment : 0 %>
                </p>
              </div>
            </div>

            <!-- Overall Performance Card -->
            <div class="bg-white dark:bg-[#1a1a2e] rounded-xl border border-slate-200 dark:border-slate-800 p-5 flex items-center gap-4 shadow-sm">
              <div class="w-12 h-12 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-500 shrink-0">
                <span class="material-symbols-outlined text-2xl">workspace_premium</span>
              </div>
              <div>
                <p class="text-xs text-slate-500 font-medium">Overall Performance</p>
                <p class="text-lg font-bold text-slate-900 dark:text-white flex items-baseline gap-1.5">
                  <% if (typeof overallGrade !== 'undefined' && overallGrade !== "N/A") { %>
                    <%= overallGrade %>
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400">
                      (<%= overallAverage %>%)
                    </span>
                  <% } else { %>
                    N/A
                  <% } %>
                </p>
              </div>
            </div>
          </div>

          <!-- Pending Assignments Section -->
          <div class="bg-white dark:bg-[#1a1a2e] rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-amber-500">assignment_late</span>
                Pending Assignments
              </h3>
              <span class="bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-400 text-xs font-bold px-2.5 py-1 rounded-full">
                <%= typeof pendingAssignments !== 'undefined' ? pendingAssignments.length : 0 %> Unsubmitted
              </span>
            </div>

            <% if (typeof pendingAssignments !== 'undefined' && pendingAssignments.length > 0) { %>
              <div class="space-y-3 custom-scrollbar max-h-80 overflow-y-auto pr-1">
                <% pendingAssignments.forEach(assignment => { %>
                  <% const isOverdue = new Date(assignment.dueDate) < new Date(); %>
                  <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
                    
                    <div class="space-y-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-primary/10 text-primary">
                          <%= assignment.subject %>
                        </span>
                        
                        <% if (isOverdue) { %>
                          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-rose-100 text-rose-600 dark:bg-rose-500/20 dark:text-rose-400 flex items-center gap-1">
                            <span class="material-symbols-outlined text-[12px]">warning</span> Overdue
                          </span>
                        <% } %>
                      </div>

                      <h4 class="font-bold text-slate-900 dark:text-white text-sm"><%= assignment.title %></h4>
                      <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">
                        <%= assignment.description || 'No instructions provided.' %>
                      </p>
                    </div>

                    <div class="flex items-center gap-4 text-xs shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-200 dark:border-slate-800 justify-between sm:justify-end">
                      <% if (assignment.attachments && assignment.attachments.length > 0) { %>
                        <span class="text-slate-400 flex items-center gap-1 text-[11px]" title="Has attachments">
                          <span class="material-symbols-outlined text-sm">attach_file</span>
                          <%= assignment.attachments.length %>
                        </span>
                      <% } %>

                      <div class="text-right">
                        <p class="text-slate-400 text-[10px] uppercase font-medium">Due Date</p>
                        <p class="font-semibold <%= isOverdue ? 'text-rose-500' : 'text-slate-700 dark:text-slate-300' %>">
                          <%= new Date(assignment.dueDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </p>
                      </div>
                    </div>

                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="py-8 text-center bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                <div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-500/20 text-emerald-500 rounded-full flex items-center justify-center mx-auto mb-2">
                  <span class="material-symbols-outlined text-2xl">task_alt</span>
                </div>
                <p class="text-sm font-bold text-slate-800 dark:text-slate-200">All Caught Up!</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">This student has submitted all assigned coursework for their class.</p>
              </div>
            <% } %>
          </div>

          <!-- Exam Record Section -->
          <div class="bg-white dark:bg-[#1a1a2e] rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-indigo-500">school</span>
                Exam Records
              </h3>
            </div>

            <% if (typeof studentExams !== 'undefined' && studentExams.length > 0) { %>
              <div class="space-y-4">
                <% studentExams.forEach(exam => { %>
                  <% 
                    let gradeColor = "text-emerald-500 bg-emerald-100 dark:bg-emerald-500/20";
                    if (exam.percentage < 40) gradeColor = "text-rose-500 bg-rose-100 dark:bg-rose-500/20";
                    else if (exam.percentage < 70) gradeColor = "text-amber-500 bg-amber-100 dark:bg-amber-500/20";
                  %>

                  <div class="p-4 rounded-xl border border-slate-100 dark:border-slate-700/50 bg-slate-50 dark:bg-slate-800/30 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    
                    <div class="space-y-1">
                      <div class="flex items-center gap-2">
                        <h4 class="font-bold text-slate-900 dark:text-white text-md"><%= exam.examName %></h4>
                        <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-indigo-100 text-indigo-600 dark:bg-indigo-500/20 dark:text-indigo-400">
                          <%= exam.subject %>
                        </span>
                      </div>
                      <p class="text-xs text-slate-500 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">calendar_today</span>
                        <%= new Date(exam.examDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                      </p>
                      <% if (exam.remarks) { %>
                        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 italic flex items-center gap-1">
                          <span class="material-symbols-outlined text-[12px]">chat</span>
                          <%= exam.remarks %>
                        </p>
                      <% } %>
                    </div>

                    <div class="flex items-center gap-4 shrink-0">
                      <div class="text-right">
                        <p class="text-[10px] uppercase font-bold text-slate-400">Score</p>
                        <p class="font-bold text-slate-900 dark:text-white text-lg">
                          <%= exam.marksObtained %> <span class="text-slate-400 text-sm font-medium">/ <%= exam.totalMarks %></span>
                        </p>
                      </div>
                      <div class="h-10 px-3 rounded-lg flex items-center justify-center font-bold text-sm <%= gradeColor %>">
                        <%= exam.percentage %>%
                      </div>
                    </div>

                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="py-8 text-center bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-500/20 text-indigo-500 rounded-full flex items-center justify-center mx-auto mb-2">
                  <span class="material-symbols-outlined text-2xl">history_edu</span>
                </div>
                <p class="text-sm font-bold text-slate-800 dark:text-slate-200">No Exams Recorded</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">There are no exam records available for this student in the current class.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>

    <!-- ==================== DRAWERS & MODALS SECTION ==================== -->

    <!-- 1. SLIDE-RIGHT EDIT PROFILE DRAWER PANEL -->
    <div id="editProfileDrawer" class="fixed inset-0 z-50 hidden">
      <div
        onclick="closeDrawer('editProfileDrawer')"
        id="editDrawerBackdrop"
        class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300 opacity-0"
      ></div>

      <div
        id="editDrawerContent"
        class="fixed inset-y-0 right-0 w-full max-w-lg bg-white dark:bg-[#1a1a2e] border-l border-slate-200 dark:border-slate-800 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col z-10"
      >
        <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center bg-slate-50 dark:bg-slate-900/50">
          <div>
            <h3 class="font-bold text-lg text-slate-900 dark:text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">edit_note</span> Edit Student Profile
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Modify account parameters directly in the institution database.
            </p>
          </div>
          <button
            type="button"
            onclick="closeDrawer('editProfileDrawer')"
            class="text-slate-400 hover:text-rose-500 transition-colors p-1 rounded-lg"
          >
            <span class="material-symbols-outlined text-xl">close</span>
          </button>
        </div>

        <form action="/teacher/student/edit/<%= student._id %>" method="POST" class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
              Full Name <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              name="name"
              value="<%= student.name %>"
              required
              class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 text-slate-900 dark:text-white"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
              Phone Number <span class="text-rose-500">*</span>
            </label>
            <input
              type="number"
              name="phone"
              value="<%= student.phone %>"
              required
              class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 text-slate-900 dark:text-white"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
              Admission Number
            </label>
            <input
              type="number"
              name="admissionNumber"
              value="<%= student.admissionNumber || '' %>"
              placeholder="e.g. 24"
              class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 text-slate-900 dark:text-white"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
              Location / Address
            </label>
            <input
              type="text"
              name="location"
              value="<%= student.location || '' %>"
              placeholder="e.g. Bokaro, Jharkhand"
              class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 text-slate-900 dark:text-white"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
              Profile Picture URL
            </label>
            <input
              type="url"
              name="profilePicUrl"
              value="<%= (student.profilePic && student.profilePic.url) ? student.profilePic.url : '' %>"
              placeholder="https://..."
              class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 text-slate-900 dark:text-white"
            />
          </div>

          <div class="pt-2">
            <label class="flex items-center gap-3 p-3.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer">
              <input
                type="checkbox"
                name="isVerified"
                value="true"
                <%= student.isVerified ? 'checked' : '' %>
                class="w-4 h-4 text-primary rounded border-slate-300 focus:ring-primary"
              />
              <div>
                <p class="text-xs font-bold text-slate-900 dark:text-white">Verified Student</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">Mark student identity as verified by teacher/school admin.</p>
              </div>
            </label>
          </div>

          <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-3">
            <button
              type="button"
              onclick="closeDrawer('editProfileDrawer')"
              class="px-5 py-2.5 text-sm font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-6 py-2.5 text-sm font-bold bg-primary text-white rounded-xl hover:bg-indigo-600 transition-colors shadow-md flex items-center gap-2"
            >
              <span class="material-symbols-outlined text-base">save</span>
              Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 2. RESET PASSWORD MODAL -->
    <div
      id="resetPasswordModal"
      class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center px-4"
    >
      <div class="bg-white dark:bg-[#1a1a2e] rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 modal-active">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-amber-500">lock_reset</span> Reset Password
          </h3>
          <button onclick="closeModal('resetPasswordModal')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
            <span class="material-symbols-outlined text-xl">close</span>
          </button>
        </div>
        <form action="/teacher/student/reset-password/<%= student._id %>" method="POST" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">New Password</label>
            <input type="password" name="newPassword" required placeholder="Enter new strong password" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 text-slate-900 dark:text-white" />
          </div>
          <div class="flex justify-end gap-3 pt-2">
            <button type="button" onclick="closeModal('resetPasswordModal')" class="px-4 py-2 text-sm font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl">Cancel</button>
            <button type="submit" class="px-5 py-2 text-sm font-bold bg-primary text-white rounded-xl hover:bg-indigo-600 transition-colors shadow-md">Reset Password</button>
          </div>
        </form>
      </div>
    </div>

    <!-- 3. SUSPEND MODAL -->
    <div
      id="suspendModal"
      class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center px-4"
    >
      <div class="bg-white dark:bg-[#1a1a2e] rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 modal-active">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-amber-500">block</span> <%= student.isSuspended ? 'Unsuspend Student' : 'Suspend Student' %>
          </h3>
          <button onclick="closeModal('suspendModal')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
            <span class="material-symbols-outlined text-xl">close</span>
          </button>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-6">
          Are you sure you want to <%= student.isSuspended ? 'unsuspend' : 'suspend' %> <strong><%= student.name %></strong>? <%= student.isSuspended ? 'The student will regain full platform access.' : 'The student will be temporarily blocked from logging in.' %>
        </p>
        <form action="/teacher/student/suspend/<%= student._id %>" method="POST" class="flex justify-end gap-3">
          <button type="button" onclick="closeModal('suspendModal')" class="px-4 py-2 text-sm font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl">Cancel</button>
          <button type="submit" class="px-5 py-2 text-sm font-bold <%= student.isSuspended ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-amber-600 hover:bg-amber-700' %> text-white rounded-xl transition-colors shadow-md">
            Confirm <%= student.isSuspended ? 'Unsuspend' : 'Suspend' %>
          </button>
        </form>
      </div>
    </div>

    <!-- 4. DELETE STUDENT MODAL -->
    <div
      id="deleteStudentModal"
      class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center px-4"
    >
      <div class="bg-white dark:bg-[#1a1a2e] rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 modal-active">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-bold text-rose-600 dark:text-rose-400 flex items-center gap-2">
            <span class="material-symbols-outlined text-rose-500">warning</span> Delete Student Profile
          </h3>
          <button onclick="closeModal('deleteStudentModal')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
            <span class="material-symbols-outlined text-xl">close</span>
          </button>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-6">
          This action is permanent and cannot be undone. Are you sure you want to delete <strong><%= student.name %></strong>'s record from ClassLoop?
        </p>
        <form action="/teacher/student/delete/<%= student._id %>?_method=DELETE" method="POST" class="flex justify-end gap-3">
          <button type="button" onclick="closeModal('deleteStudentModal')" class="px-4 py-2 text-sm font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl">Cancel</button>
          <button type="submit" class="px-5 py-2 text-sm font-bold bg-rose-600 hover:bg-rose-700 text-white rounded-xl transition-colors shadow-md">
            Permanently Delete
          </button>
        </form>
      </div>
    </div>

    <!-- Client-side Scripts -->
    <script>
      // 1. Calendar Dynamic Renderer
      document.addEventListener("DOMContentLoaded", () => {
        const attendanceMap = <%- attendanceMap || '{}' %>;
        const calendarBody = document.getElementById('calendar-body');
        const now = new Date();
        const year = now.getFullYear();
        const month = now.getMonth();

        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();

        let html = '';

        for (let i = 0; i < firstDay; i++) {
          html += `<div></div>`;
        }

        for (let day = 1; day <= daysInMonth; day++) {
          const status = attendanceMap[day];
          let classes = "w-8 h-8 mx-auto flex items-center justify-center rounded-full text-slate-700 dark:text-slate-300";

          if (status === 1) {
            classes += " bg-emerald-500 !text-white font-bold";
          } else if (status === 2) {
            classes += " bg-rose-500 !text-white font-bold";
          } else if (status === 3) {
            classes += " bg-amber-400 !text-white font-bold";
          } else {
            classes += " bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700";
          }

          html += `<div class="py-1 text-center"><div class="${classes}">${day}</div></div>`;
        }

        if (calendarBody) {
          calendarBody.innerHTML = html;
        }
      });

      // 2. Interactive Modals & Slide Drawer Helpers
      function openDrawer(drawerId) {
        const drawer = document.getElementById(drawerId);
        if (!drawer) return;
        drawer.classList.remove('hidden');
        setTimeout(() => {
          document.getElementById('editDrawerBackdrop')?.classList.remove('opacity-0');
          document.getElementById('editDrawerContent')?.classList.remove('translate-x-full');
        }, 10);
      }

      function closeDrawer(drawerId) {
        document.getElementById('editDrawerBackdrop')?.classList.add('opacity-0');
        document.getElementById('editDrawerContent')?.classList.add('translate-x-full');
        setTimeout(() => {
          document.getElementById(drawerId)?.classList.add('hidden');
        }, 300);
      }

      function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) modal.classList.remove('hidden');
      }

      function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) modal.classList.add('hidden');
      }
    </script>
  </body>
</html>