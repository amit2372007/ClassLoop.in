<%- include("../includes/loader.ejs") -%>
<% layout("/layout/boilerplate2.ejs") -%>
<main class="flex-1 flex flex-col items-center py-8 px-4 sm:px-6 lg:px-8">
          <div class="w-full max-w-[1000px] flex flex-col gap-8">
            
            <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium">
              <a class="hover:text-primary" href="/school">Principal Panel</a>
              <span class="material-symbols-outlined text-xs">chevron_right</span>
              <span class="text-slate-900 dark:text-slate-100">Joining Requests</span>
            </nav>

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                    Teacher Joining Requests
                  </h1>
                  <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full uppercase tracking-wider border border-primary/20">
                    <%= requests.length %> Pending
                  </span>
                </div>
                <p class="text-slate-500 dark:text-slate-400 text-base">
                  Review and manage incoming faculty applications for your school.
                </p>
              </div>
              <a href="/school?tab=Teachers" class="flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all font-bold text-sm">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                Back to Faculty
              </a>
            </div>

            <div class="flex flex-col gap-6">
              
              <% if (requests && requests.length > 0) { %>
                <% requests.forEach(request => { %>
                  <div class="bg-white dark:bg-slate-900 p-6 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 hover:shadow-md transition-shadow group">
                    
                    <div class="flex items-start sm:items-center gap-5 flex-1">
                      <div class="relative">
                        <div class="size-16 rounded-full overflow-hidden border-2 border-primary/10 bg-slate-50">
                          <img
                            alt="<%= request.sender?.name || 'Applicant' %>"
                            class="w-full h-full object-cover"
                            src="<%= request.sender?.profilePic?.url || 'https://ui-avatars.com/api/?name=' + (request.sender?.name || 'User') %>"
                          />
                        </div>
                      </div>
                      
                      <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2">
                          <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                            <%= request.sender?.name || 'Unknown User' %>
                          </h3>
                          <span class="text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-tighter">
                            <%= new Date(request.createdAt).toLocaleDateString() %>
                          </span>
                        </div>
                        <p class="text-sm font-semibold text-primary">
                          Request for Faculty
                        </p>
                        
                        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1">
                          <span class="flex items-center gap-1 text-slate-500 dark:text-slate-400 text-xs">
                            <span class="material-symbols-outlined text-[14px]">mail</span>
                            <%= request.sender?.email || 'N/A' %>
                          </span>
                          <% if (request.sender?.phone) { %>
                            <span class="flex items-center gap-1 text-slate-500 dark:text-slate-400 text-xs">
                              <span class="material-symbols-outlined text-[14px]">call</span>
                              <%= request.sender.phone %>
                            </span>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="flex items-center gap-3 w-full lg:w-auto">
                      
                      <form action="/school/teacher-request/<%= request._id %>/approve" method="POST" class="flex-1 lg:flex-none">
                        <button type="submit" class="w-full flex items-center justify-center gap-2 px-6 py-2.5 bg-emerald-600 hover:bg-emerald-600 text-white rounded-xl font-bold text-sm shadow-lg shadow-emerald-500/20 transition-all active:scale-95">
                          <span class="material-symbols-outlined text-[18px]">check_circle</span>
                          Approve
                        </button>
                      </form>

                      <form action="/school/teacher-request/<%= request._id %>/reject" method="POST" class="flex-1 lg:flex-none">
                        <button type="submit" class="w-full flex items-center justify-center gap-2 px-6 py-2.5 bg-rose-600 hover:bg-rose-600 text-white rounded-xl font-bold text-sm shadow-lg shadow-rose-500/20 transition-all active:scale-95">
                          <span class="material-symbols-outlined text-[18px]">cancel</span>
                          Reject
                        </button>
                      </form>

                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                
                <div class="flex flex-col items-center justify-center py-20 px-4 text-center bg-white dark:bg-slate-900 rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800">
                  <div class="size-32 bg-primary/5 rounded-full flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-6xl text-primary/40">task_alt</span>
                  </div>
                  <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">
                    All caught up!
                  </h3>
                  <p class="text-slate-500 dark:text-slate-400 max-w-sm">
                    No pending joining requests at the moment. We'll notify you when a new teacher applies.
                  </p>
                  <a href="/school?tab=Teachers" class="mt-8 text-primary font-bold hover:underline flex items-center gap-2">
                    Go to Dashboard
                    <span class="material-symbols-outlined">arrow_forward</span>
                  </a>
                </div>

              <% } %>
            </div>
            
          </div>
          <script src="/js/loader.js" ></script>
        </main>