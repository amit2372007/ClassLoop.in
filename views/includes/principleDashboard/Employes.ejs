<main class="flex-1 ml-64 min-h-screen flex flex-col relative">
  <header class="h-20 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-8 sticky top-0 z-10">
    <div>
      <h2 class="text-xl font-bold text-slate-800 dark:text-white">
        Employee Management
      </h2>
      <p class="text-slate-500 text-sm">
        Oversee and manage non-teaching staff operations
      </p>
    </div>
    <div class="flex items-center gap-4">
      <button id="openAddEmployeeBtn" class="bg-primary text-white px-4 py-2 rounded-lg font-semibold text-sm flex items-center gap-2 hover:bg-[#4338ca] transition-colors shadow-sm active:scale-95">
        <span class="material-symbols-outlined text-xl">add</span>
        Add Employee
      </button>
      <div class="h-8 w-[1px] bg-slate-200 dark:bg-slate-700 mx-2"></div>
      <div class="flex items-center gap-3">
        <div class="text-right hidden sm:block">
          <p class="text-sm font-bold text-slate-800 dark:text-white">
            <%=Principle.name%>
          </p>
          <p class="text-xs text-slate-500">Principal Administrator</p>
        </div>
        <div class="size-10 rounded-full bg-primary/20 flex items-center justify-center overflow-hidden border-2 border-primary/30">
          <img alt="Principal Profile" class="w-full h-full object-cover" src="<%=Principle.profilePic.url%>" />
        </div>
      </div>
    </div>
  </header>

  <div class="p-8 space-y-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-4">
          <div class="size-12 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined">group</span>
          </div>
          <div>
            <p class="text-slate-500 text-xs font-bold uppercase tracking-wider">Total Staff</p>
            <h3 class="text-2xl font-bold text-slate-800 dark:text-white">
              <%= employeeStats.total || 0 %>
            </h3>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-4">
          <div class="size-12 rounded-lg bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-blue-600">
            <span class="material-symbols-outlined">computer</span>
          </div>
          <div>
            <p class="text-slate-500 text-xs font-bold uppercase tracking-wider">IT Dept</p>
            <h3 class="text-2xl font-bold text-slate-800 dark:text-white">
              <%= employeeStats.it || 0 %>
            </h3>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-4">
          <div class="size-12 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600">
            <span class="material-symbols-outlined">admin_panel_settings</span>
          </div>
          <div>
            <p class="text-slate-500 text-xs font-bold uppercase tracking-wider">Administration</p>
            <h3 class="text-2xl font-bold text-slate-800 dark:text-white">
              <%= employeeStats.admin || 0 %>
            </h3>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-4">
          <div class="size-12 rounded-lg bg-rose-50 dark:bg-rose-900/30 flex items-center justify-center text-rose-600">
            <span class="material-symbols-outlined">engineering</span>
          </div>
          <div>
            <p class="text-slate-500 text-xs font-bold uppercase tracking-wider">Maintenance</p>
            <h3 class="text-2xl font-bold text-slate-800 dark:text-white">
              <%= employeeStats.maintenance || 0 %>
            </h3>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-gradient-to-r from-primary/5 to-indigo-50 dark:from-primary/10 dark:to-indigo-900/20 rounded-xl shadow-sm border border-primary/20 dark:border-primary/30 p-5 md:p-6 flex flex-col lg:flex-row items-center justify-between gap-4">
      
      <div class="w-full lg:w-auto text-left">
        <h3 class="text-lg font-bold text-slate-800 dark:text-white flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">payments</span>
          Generate Monthly Payroll
        </h3>
        <p class="text-xs text-slate-500 mt-1 font-medium">
          Automatically calculate and generate salary records for all active employees.
        </p>
      </div>

      <form 
        action="/school/employee/generate-salary" 
        method="POST" 
        class="flex flex-col sm:flex-row items-center gap-3 w-full lg:w-auto"
        onsubmit="return confirm('Are you sure you want to generate payroll for this month? This will process salaries for all active staff.');"
      >
        <select 
          name="month" 
          required 
          class="w-full sm:w-40 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary/50 outline-none"
        >
          <option value="" disabled selected>Select Month</option>
          <option value="January">January</option>
          <option value="February">February</option>
          <option value="March">March</option>
          <option value="April">April</option>
          <option value="May">May</option>
          <option value="June">June</option>
          <option value="July">July</option>
          <option value="August">August</option>
          <option value="September">September</option>
          <option value="October">October</option>
          <option value="November">November</option>
          <option value="December">December</option>
        </select>

        <input 
          type="number" 
          name="year" 
          required 
          value="<%= new Date().getFullYear() %>" 
          min="2020" max="2100" 
          class="w-full sm:w-28 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary/50 outline-none text-center" 
        />

        <button 
          type="submit" 
          class="w-full sm:w-auto bg-primary text-white px-6 py-2.5 rounded-lg font-bold text-sm flex items-center justify-center gap-2 hover:bg-[#4338ca] transition-all shadow-md shadow-primary/20 active:scale-95 whitespace-nowrap"
        >
          <span class="material-symbols-outlined text-base">receipt_long</span>
          Generate
        </button>
      </form>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800 overflow-hidden">
      <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row gap-4 justify-between items-center">
        <div class="relative w-full sm:w-96">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xl">search</span>
          <input id="employeeSearchInput" class="w-full pl-10 pr-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-background-light dark:bg-slate-800 text-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none" placeholder="Search by name, role or employee ID..." type="text" />
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <select id="employeeDeptFilter" class="w-full sm:w-48 bg-background-light dark:bg-slate-800 border-slate-200 dark:border-slate-700 rounded-lg text-sm font-medium focus:ring-primary">
            <option value="all">All Departments</option>
            <option value="Academic">Academic</option>
            <option value="Administration">Administration</option>
            <option value="Transport">Transport</option>
            <option value="Maintenance">Maintenance</option>
            <option value="Finance">Finance</option>
            <option value="IT Support">IT Support</option>
            <option value="Sports/Physical Education">Sports/Physical Education</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="bg-slate-50 dark:bg-slate-800/50">
            <tr>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Role</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Department</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Salary</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800" id="employeeTableBody">
            <% if (allEmployees && allEmployees.length > 0) { %>
              <% allEmployees.forEach(emp => { %>
                <tr class="employee-row hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors"
                    data-name="<%= emp.name.toLowerCase() %>"
                    data-role="<%= emp.designation.toLowerCase() %>"
                    data-empid="<%= emp.employeeId.toLowerCase() %>"
                    data-dept="<%= emp.department %>">
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <img alt="Profile" class="size-10 rounded-full object-cover border border-slate-200 dark:border-slate-700" 
                           src="<%= (emp.user && emp.user.profilePic) ? emp.user.profilePic.url : 'https://ui-avatars.com/api/?name=' + emp.name + '&background=random' %>" />
                      <div>
                        <p class="text-sm font-semibold text-slate-800 dark:text-white"><%= emp.name %></p>
                        <p class="text-[10px] font-medium text-slate-500">ID: <%= emp.employeeId %></p>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">
                    <%= emp.designation %>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">
                    <%= emp.department %>
                  </td>
                  <td class="px-6 py-4">
                    <p class="text-sm font-bold text-slate-700 dark:text-slate-200">
                      ₹<%= emp.basicSalary.toLocaleString('en-IN') %>
                    </p>
                    <p class="text-[10px] text-slate-500 uppercase tracking-tight">Monthly Basic</p>
                  </td>
                  <td class="px-6 py-4">
                    <% 
                      let statusColor = "bg-slate-100 text-slate-600";
                      if(emp.status === 'Active') statusColor = "bg-emerald-50 text-emerald-600";
                      if(emp.status === 'On Leave') statusColor = "bg-amber-50 text-amber-600";
                      if(emp.status === 'Suspended') statusColor = "bg-rose-50 text-rose-600";
                    %>
                    <span class="px-2.5 py-0.5 <%= statusColor %> text-xs font-bold rounded-full">
                      <%= emp.status %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex justify-end gap-2">
                      <button 
                        type="button"
                        class="editEmployeeBtn size-8 flex items-center justify-center rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-900/30 text-slate-400 hover:text-primary transition-colors"
                        title="Edit Employee"
                        data-id="<%= emp._id %>"
                        data-name="<%= emp.name %>"
                        data-phone="<%= emp.phone %>"
                        data-address="<%= emp.address %>"
                        data-employeeid="<%= emp.employeeId %>"
                        data-designation="<%= emp.designation %>"
                        data-department="<%= emp.department %>"
                        data-dateofjoining="<%= emp.dateOfJoining ? new Date(emp.dateOfJoining).toISOString().split('T')[0] : '' %>"
                        data-status="<%= emp.status %>"
                        data-basicsalary="<%= emp.basicSalary %>"
                        data-accountholdername="<%= emp.bankDetails?.accountHolderName || '' %>"
                        data-accountnumber="<%= emp.bankDetails?.accountNumber || '' %>"
                        data-ifsccode="<%= emp.bankDetails?.ifscCode || '' %>"
                        data-bankname="<%= emp.bankDetails?.bankName || '' %>"
                        data-qualifications="<%= emp.qualifications ? emp.qualifications.join(', ') : '' %>"
                        data-experienceyears="<%= emp.experienceYears || 0 %>"
                        data-aadharnumber="<%= emp.documents?.aadharNumber || '' %>"
                        data-pannumber="<%= emp.documents?.panNumber || '' %>"
                      >
                        <span class="material-symbols-outlined text-xl">edit</span>
                      </button>

                      <form 
                        action="/school/employee/<%= emp._id %>/delete" 
                        method="POST" 
                        class="inline-block m-0 p-0"
                        onsubmit="return confirm('Are you sure you want to permanently remove <%= emp.name %> from the system?');"
                      >
                        <button 
                          type="submit" 
                          class="size-8 flex items-center justify-center rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/30 text-slate-400 hover:text-rose-600 transition-colors"
                          title="Delete Employee"
                        >
                          <span class="material-symbols-outlined text-xl">delete</span>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
            
            <tr id="noResultsRow" style="display: <%= (allEmployees && allEmployees.length > 0) ? 'none' : '' %>;">
              <td colspan="6" class="px-6 py-12 text-center text-slate-500 italic">
                No employees found matching your search criteria.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="p-6 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <p class="text-sm text-slate-500">
          Showing <span class="font-bold text-slate-800 dark:text-white" id="visibleCountDisplay"><%= employeeStats.total || 0 %></span> of <span class="font-bold text-slate-800 dark:text-white"><%= employeeStats.total || 0 %></span> employees
        </p>
      </div>
    </div>
  </div>

  <div id="employeeFormBackdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden transition-opacity duration-300 opacity-0"></div>

  <aside id="employeeFormSidebar" class="fixed top-0 right-0 h-screen w-full md:w-[600px] lg:w-[700px] bg-white dark:bg-slate-900 z-50 transform translate-x-full transition-transform duration-300 ease-in-out shadow-2xl flex flex-col">
    <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-white dark:bg-slate-900 sticky top-0 z-20">
      <div>
        <h2 id="sidebarTitle" class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">
          Add New Employee
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Register a new staff member to the system.
        </p>
      </div>
      <button id="closeAddEmployeeBtn" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 transition-colors">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-6">
      <form id="addEmployeeForm" action="/school/employee/add" method="POST" class="space-y-6">
        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
          <div class="px-5 py-3 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800 flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-lg">person</span>
            <h3 class="font-semibold text-sm text-slate-800 dark:text-slate-200">Personal Information</h3>
          </div>
          <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-5">
            
            <!-- Autofill Staff Selection -->
            <div class="space-y-1.5 md:col-span-2 mb-2 p-4 bg-indigo-50/50 dark:bg-indigo-900/20 rounded-lg border border-indigo-100 dark:border-indigo-800/30">
              <label class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm">magic_button</span>
                Autofill from Existing Staff (Optional)
              </label>
              <select name="staffId" id="staffAutofillSelect" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary/50 outline-none text-slate-700 dark:text-slate-300">
                <option value="">-- Select a staff member to autofill details --</option>
                <% if (typeof availableStaff !== 'undefined' && availableStaff.length > 0) { %>
                  <% availableStaff.forEach(staff => { %>
                    <option value="<%= staff._id %>"
                            data-name="<%= staff.name %>"
                            data-phone="<%= staff.phone %>"
                            data-address="<%= staff.address %>"
                            data-designation="<%= staff.designation %>"
                            data-department="<%= staff.department %>"
                            data-qualifications="<%= staff.qualifications ? staff.qualifications.join(', ') : '' %>"
                            data-experience="<%= staff.experienceYears %>"
                            data-employeeid="<%= staff.employeeId || staff._id %>"> 
                      <%= staff.name %> - <%= staff.designation %>
                    </option>
                  <% }) %>
                <% } %>
              </select>
            </div>

            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Full Name*</label>
              <input name="name" required class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="e.g. John Doe" type="text" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Phone Number</label>
              <input name="phone" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="+91 00000 00000" type="tel" />
            </div>
            <div class="space-y-1.5 md:col-span-2">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Address</label>
              <textarea name="address" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none resize-none" placeholder="Residential Address" rows="2"></textarea>
            </div>
          </div>
        </div>

        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
          <div class="px-5 py-3 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800 flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-lg">badge</span>
            <h3 class="font-semibold text-sm text-slate-800 dark:text-slate-200">Professional Details</h3>
          </div>
          <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Employee ID</label>
              <input name="employeeId" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="EMP-2024-001" type="text" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Designation*</label>
              <input name="designation" required class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="e.g. Senior Teacher" type="text" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Department*</label>
              <select name="department" required class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none">
                <option value="">Select Department</option>
                <option value="Teaching Staff">Teaching Staff</option>
                <option value="School Administration">School Administration</option>
                <option value="Maintainance & Support Staff">Maintainance & Support Staff</option>
                <option value="Security & Transport Staff">Security & Transport Staff</option>
                <option value="Food & Hospitality Staff">Food & Hospitality Staff</option>
                <option value="Technical and Library Staff">Technical and Library Staff</option>
              
              </select>
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Date of Joining*</label>
              <input name="dateOfJoining" required class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" type="date" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Status</label>
              <select name="status" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none">
                <option value="Active">Active</option>
                <option value="On Leave">On Leave</option>
                <option value="Resigned">Resigned</option>
                <option value="Terminated">Terminated</option>
                <option value="Suspended">Suspended</option>
              </select>
            </div>
          </div>
        </div>

        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
          <div class="px-5 py-3 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800 flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-lg">account_balance</span>
            <h3 class="font-semibold text-sm text-slate-800 dark:text-slate-200">Payroll & Banking</h3>
          </div>
          <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Basic Salary (Monthly)*</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 font-medium">₹</span>
                <input name="basicSalary" required class="w-full pl-7 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="50000" type="number" />
              </div>
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Account Holder Name</label>
              <input name="accountHolderName" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="Full name as per bank" type="text" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Account Number</label>
              <input name="accountNumber" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="000000000000" type="text" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">IFSC Code</label>
              <input name="ifscCode" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="SBIN0001234" type="text" />
            </div>
            <div class="space-y-1.5 md:col-span-2">
              <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Bank Name</label>
              <input name="bankName" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="e.g. State Bank of India" type="text" />
            </div>
          </div>
        </div>

        <div class="bg-slate-50/50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
          <div class="px-5 py-3 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800 flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-lg">school</span>
            <h3 class="font-semibold text-sm text-slate-800 dark:text-slate-200">Qualifications & Documents</h3>
          </div>
          <div class="p-5 space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="space-y-1.5">
                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Qualifications (comma separated)</label>
                <input name="qualifications" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="B.Ed, M.Sc" type="text" />
              </div>
              <div class="space-y-1.5">
                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Experience (Years)</label>
                <input name="experienceYears" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="0" type="number" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="space-y-1.5">
                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Aadhar Card Number</label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">fingerprint</span>
                  <input name="aadharNumber" type="text" maxlength="12" pattern="\d{12}" title="Please enter a 12-digit Aadhar number" class="w-full pl-10 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none" placeholder="123456789012" />
                </div>
              </div>
              <div class="space-y-1.5">
                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">PAN Card Number</label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">credit_card</span>
                  <input name="panNumber" type="text" maxlength="10" title="Please enter a valid PAN number" class="w-full pl-10 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary/50 outline-none uppercase" placeholder="ABCDE1234F" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>

    <div class="px-6 py-4 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex items-center justify-end gap-3 sticky bottom-0 z-20">
      <button id="discardEmployeeBtn" class="px-4 py-2.5 text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors" type="button">
        Discard
      </button>
      <button form="addEmployeeForm" class="px-6 py-2.5 text-sm font-bold text-white bg-gradient-to-r from-primary to-indigo-600 hover:from-indigo-700 hover:to-primary rounded-lg shadow-lg shadow-primary/20 transition-all flex items-center gap-2 active:scale-95" type="submit">
        <span class="material-symbols-outlined text-lg">person_add</span>
        <span id="submitBtnText">Add Employee</span>
      </button>
    </div>
  </aside>
</main>

<script>
  // ==========================================
  // REAL-TIME SEARCH & FILTER LOGIC
  // ==========================================
  const searchInput = document.getElementById("employeeSearchInput");
  const deptFilter = document.getElementById("employeeDeptFilter");
  const employeeRows = document.querySelectorAll(".employee-row");
  const noResultsRow = document.getElementById("noResultsRow");
  const visibleCountDisplay = document.getElementById("visibleCountDisplay");

  function filterEmployees() {
    const searchTerm = searchInput.value.toLowerCase().trim();
    const filterDept = deptFilter.value;
    let visibleCount = 0;

    employeeRows.forEach(row => {
      const name = row.dataset.name || "";
      const role = row.dataset.role || "";
      const empId = row.dataset.empid || "";
      const dept = row.dataset.dept || "";

      const matchesSearch = name.includes(searchTerm) || role.includes(searchTerm) || empId.includes(searchTerm);
      const matchesDept = (filterDept === "all") || (dept === filterDept);

      if (matchesSearch && matchesDept) {
        row.style.display = ""; 
        visibleCount++;
      } else {
        row.style.display = "none";
      }
    });
    
    noResultsRow.style.display = visibleCount === 0 ? "" : "none";
    if (visibleCountDisplay) {
      visibleCountDisplay.textContent = visibleCount;
    }
  }

  if (searchInput) searchInput.addEventListener("input", filterEmployees);
  if (deptFilter) deptFilter.addEventListener("change", filterEmployees);

  // ==========================================
  // SIDEBAR & FORM LOGIC (ADD / EDIT)
  // ==========================================
  const sidebar = document.getElementById('employeeFormSidebar');
  const backdrop = document.getElementById('employeeFormBackdrop');
  const addBtn = document.getElementById('openAddEmployeeBtn');
  const closeBtn = document.getElementById('closeAddEmployeeBtn');
  const discardBtn = document.getElementById('discardEmployeeBtn');
  const form = document.getElementById('addEmployeeForm');
  const sidebarTitle = document.getElementById('sidebarTitle');
  const submitBtnText = document.getElementById('submitBtnText');
  const staffAutofillSelect = document.getElementById('staffAutofillSelect');

  function openSidebar() {
    sidebar.classList.remove('translate-x-full');
    backdrop.classList.remove('hidden');
    // Small delay ensures the browser registers the block display before fading in
    setTimeout(() => backdrop.classList.remove('opacity-0'), 10); 
  }

  function closeSidebar() {
    sidebar.classList.add('translate-x-full');
    backdrop.classList.add('opacity-0');
    setTimeout(() => {
      backdrop.classList.add('hidden');
      resetForm();
    }, 300); // Matches CSS transition duration
  }

  function resetForm() {
    form.reset();
    form.action = '/school/employee/add';
    sidebarTitle.textContent = 'Add New Employee';
    submitBtnText.textContent = 'Add Employee';
    if (staffAutofillSelect) {
      staffAutofillSelect.disabled = false;
      staffAutofillSelect.closest('div').style.display = '';
    }
  }

  if (addBtn) addBtn.addEventListener('click', openSidebar);
  if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
  if (discardBtn) discardBtn.addEventListener('click', closeSidebar);
  if (backdrop) backdrop.addEventListener('click', closeSidebar);

  // ==========================================
  // EDIT BUTTON LOGIC
  // ==========================================
  const editBtns = document.querySelectorAll('.editEmployeeBtn');
  editBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const data = e.currentTarget.dataset;
      
      // Hide & disable autofill when editing an existing employee
      if (staffAutofillSelect) {
        staffAutofillSelect.disabled = true;
        staffAutofillSelect.closest('div').style.display = 'none';
      }

      // Populate form fields
      form.querySelector('[name="name"]').value = data.name || '';
      form.querySelector('[name="phone"]').value = data.phone || '';
      form.querySelector('[name="address"]').value = data.address || '';
      form.querySelector('[name="employeeId"]').value = data.employeeid || '';
      form.querySelector('[name="designation"]').value = data.designation || '';
      form.querySelector('[name="department"]').value = data.department || '';
      form.querySelector('[name="dateOfJoining"]').value = data.dateofjoining || '';
      form.querySelector('[name="status"]').value = data.status || 'Active';
      form.querySelector('[name="basicSalary"]').value = data.basicsalary || '';
      form.querySelector('[name="accountHolderName"]').value = data.accountholdername || '';
      form.querySelector('[name="accountNumber"]').value = data.accountnumber || '';
      form.querySelector('[name="ifscCode"]').value = data.ifsccode || '';
      form.querySelector('[name="bankName"]').value = data.bankname || '';
      form.querySelector('[name="qualifications"]').value = data.qualifications || '';
      form.querySelector('[name="experienceYears"]').value = data.experienceyears || '';
      form.querySelector('[name="aadharNumber"]').value = data.aadharnumber || '';
      form.querySelector('[name="panNumber"]').value = data.pannumber || '';

      // Update UI for Edit Mode
      sidebarTitle.textContent = 'Edit Employee Details';
      submitBtnText.textContent = 'Update Employee';
      
      // Update form action route (assuming an update route pattern like /school/employee/:id/update)
      form.action = `/school/employee/${data.id}/update`;
      
      openSidebar();
    });
  });

  // ==========================================
  // AUTOFILL LOGIC (ADD MODE ONLY)
  // ==========================================
  if (staffAutofillSelect) {
    staffAutofillSelect.addEventListener('change', (e) => {
      const selectedOption = e.target.options[e.target.selectedIndex];
      if (!selectedOption.value) {
        resetForm();
        return; 
      }
      
      const data = selectedOption.dataset;
      form.querySelector('[name="name"]').value = data.name || '';
      form.querySelector('[name="phone"]').value = data.phone || '';
      form.querySelector('[name="address"]').value = data.address || '';
      form.querySelector('[name="employeeId"]').value = data.employeeid || '';
      form.querySelector('[name="designation"]').value = data.designation || '';
      form.querySelector('[name="department"]').value = data.department || '';
      form.querySelector('[name="qualifications"]').value = data.qualifications || '';
      form.querySelector('[name="experienceYears"]').value = data.experience || '';
    });
  }
</script>