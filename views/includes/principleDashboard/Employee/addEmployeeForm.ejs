<main class="flex-1 flex flex-col h-screen overflow-y-auto">
  <!-- Header -->
  <header class="sticky top-0 z-10 flex items-center justify-between px-8 py-4 bg-white/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-4">
      <button class="lg:hidden p-2 text-slate-600 dark:text-slate-400">
        <span class="material-symbols-outlined">menu</span>
      </button>
      <div class="flex items-center gap-2 text-sm text-slate-500">
        <span>Dashboard</span>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span>Employees</span>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-slate-900 dark:text-slate-100 font-medium">Add  Employee</span>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <div class="relative hidden md:block">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
        <input class="pl-10 pr-4 py-2 bg-slate-100 dark:bg-slate-800 border-none rounded-lg text-sm w-64 focus:ring-2 focus:ring-primary/50 transition-all" placeholder="Search..." type="text" />
      </div>
      <button class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-400 relative">
        <span class="material-symbols-outlined">notifications</span>
        <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white dark:border-background-dark"></span>
      </button>
      <div class="h-8 w-8 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold text-xs overflow-hidden">
        <img alt="User Profile" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/..." />
      </div>
    </div>
  </header>

  <!-- Content Area -->
  <div class="p-8 max-w-5xl mx-auto w-full">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">
        Add New Employee
      </h1>
      <p class="text-slate-500 dark:text-slate-400 mt-1">
        Register a new staff member to the management system.
      </p>
    </div>

    <form class="space-y-6">
      <!-- Section 1: Personal Information -->
      <div class="bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">person</span>
          <h2 class="font-semibold text-slate-800 dark:text-slate-200">
            Personal Information 
          </h2>
        </div>
        
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- NEW: Auto-fill Existing Staff Dropdown -->
          <div class="space-y-2 md:col-span-2 p-4 bg-primary/5 border border-primary/20 rounded-lg">
            <label class="text-xs font-bold text-primary uppercase tracking-wider">
              <span class="material-symbols-outlined text-[14px] align-middle mr-1">magic_button</span> 
              Auto-fill from existing Teachers/Staff (Optional)
            </label>
            <select 
              id="autoFillStaffSelect"
              class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary"
            >
              <option value="">-- Select a member to auto-fill details --</option>
              <% if (typeof allTeachers !== 'undefined' && allTeachers.length > 0) { %>
                <% allTeachers.forEach(staff => { %>
                  <!-- Using data-* attributes to pass DB data to JavaScript safely -->
                  <option 
                    value="<%= staff._id %>"
                    data-name="<%= staff.name || '' %>"
                    data-phone="<%= staff.phone || '' %>"
                    data-address="<%= staff.address || '' %>"
                    data-doj="<%= staff.createdAt ? new Date(staff.createdAt).toISOString().split('T')[0] : '' %>"
                  >
                    <%= staff.name %> (Teacher)
                  </option>
                <% }) %>
              <% } %>
            </select>
            <p class="text-xs text-slate-500 mt-1">Selecting a profile will automatically populate known information below.</p>
          </div>

          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Full Name</label>
            <input
              id="empName"
              class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary transition-all"
              placeholder="e.g. John Doe"
              type="text"
            />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Phone Number</label>
            <input
              id="empPhone"
              class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary transition-all"
              placeholder="+91 00000 00000"
              type="tel"
            />
          </div>
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Address</label>
            <textarea
              id="empAddress"
              class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary transition-all"
              placeholder="Residential Address"
              rows="2"
            ></textarea>
          </div>
        </div>
      </div>

      <!-- Section 2: Professional Details -->
      <div class="bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">badge</span>
          <h2 class="font-semibold text-slate-800 dark:text-slate-200">Professional Details</h2>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Employee ID</label>
            <input class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary" placeholder="EMP-2024-001" type="text" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Designation</label>
            <input class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary" placeholder="e.g. Senior Teacher" type="text" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Department</label>
            <select class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary">
              <option>Select Department</option>
              <option>Mathematics</option>
              <option>Science</option>
              <option>Languages</option>
              <option>Administration</option>
            </select>
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Date of Joining</label>
            <input id="empDoj" class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary transition-all" type="date" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Employment Status</label>
            <select class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary">
              <option>Full-time</option>
              <option>Part-time</option>
              <option>Contractual</option>
              <option>Probation</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Section 3: Payroll & Banking -->
      <div class="bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">account_balance</span>
          <h2 class="font-semibold text-slate-800 dark:text-slate-200">Payroll &amp; Banking</h2>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Basic Salary (Monthly)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">₹</span>
              <input class="w-full pl-8 bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary" placeholder="50000" type="number" />
            </div>
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Account Holder Name</label>
            <input id="empBankName" class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary transition-all" placeholder="Full name as per bank" type="text" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Account Number</label>
            <input class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary" placeholder="000000000000" type="text" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Bank IFSC Code</label>
            <input class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary" placeholder="SBIN0001234" type="text" />
          </div>
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Bank Name</label>
            <input class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary" placeholder="e.g. State Bank of India" type="text" />
          </div>
        </div>
      </div>

      <!-- Section 4: Academic & Documents (unchanged) -->
      <div class="bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">description</span>
          <h2 class="font-semibold text-slate-800 dark:text-slate-200">Academic &amp; Documents</h2>
        </div>
        <div class="p-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Highest Qualification</label>
              <input class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary" placeholder="e.g. M.Sc in Mathematics" type="text" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Experience (Years)</label>
              <input class="w-full bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary" placeholder="5" type="number" />
            </div>
          </div>
          <!-- Uploads remain unchanged -->
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-end gap-4 py-8">
        <button class="px-6 py-2.5 text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors" type="button">
          Discard Changes
        </button>
        <button class="px-8 py-2.5 text-sm font-bold text-white bg-gradient-to-r from-primary to-[#6366f1] hover:from-[#4338ca] hover:to-primary rounded-lg shadow-lg shadow-primary/20 transition-all flex items-center gap-2" type="submit">
          <span class="material-symbols-outlined text-lg">person_add</span>
          Add Employee
        </button>
      </div>
    </form>
  </div>
</main>

<!-- JAVASCRIPT FOR AUTO-FILL FUNCTIONALITY -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const staffSelect = document.getElementById("autoFillStaffSelect");
    
    // Target Inputs
    const nameInput = document.getElementById("empName");
    const phoneInput = document.getElementById("empPhone");
    const addressInput = document.getElementById("empAddress");
    const dojInput = document.getElementById("empDoj");
    const bankNameInput = document.getElementById("empBankName");

    // Add brief highlight animation when values change
    const highlightField = (element) => {
      element.classList.add('ring-2', 'ring-primary', 'bg-primary/5');
      setTimeout(() => {
        element.classList.remove('ring-2', 'ring-primary', 'bg-primary/5');
      }, 800);
    };

    staffSelect.addEventListener("change", function () {
      const selectedOption = this.options[this.selectedIndex];
      
      // If user sets it back to default, we don't clear the form (user choice), we just do nothing.
      if (!this.value) return;

      // Extract data from the selected <option>
      const data = selectedOption.dataset;

      // Populate Name
      if (data.name) {
        nameInput.value = data.name;
        bankNameInput.value = data.name; // Usually same as bank holder name
        highlightField(nameInput);
        highlightField(bankNameInput);
      }
      
      // Populate Phone
      if (data.phone) {
        phoneInput.value = data.phone;
        highlightField(phoneInput);
      }
      
      // Populate Address
      if (data.address) {
        addressInput.value = data.address;
        highlightField(addressInput);
      }

      // Populate Date of Joining
      if (data.doj) {
        dojInput.value = data.doj; // Requires YYYY-MM-DD format which we did in EJS
        highlightField(dojInput);
      }
    });
  });
</script>