<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ClassLoop</title>
  </head>
  <body>
    <!-- ===== CLASSLOOP LOADER: copy from here ... ===== -->
    <style>
      #global-loader {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        min-height: 100dvh;
        padding: 24px;
        color: #fff;
        text-align: center;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        background:
          radial-gradient(
            55% 45% at 50% 36%,
            rgba(167, 139, 250, 0.5),
            transparent 70%
          ),
          linear-gradient(150deg, #3b1a8a 0%, #5b21b6 48%, #7c3aed 100%);
        opacity: 1;
        visibility: visible;
        transition:
          opacity 0.45s ease,
          visibility 0.45s;
        -webkit-font-smoothing: antialiased;
      }
      #global-loader.is-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      #global-loader *,
      #global-loader *::before,
      #global-loader *::after {
        box-sizing: border-box;
      }

      #global-loader .cl-card {
        width: 112px;
        height: 112px;
        border-radius: 30px;
        display: grid;
        place-items: center;
        background: linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.22),
          rgba(255, 255, 255, 0.06)
        );
        border: 1px solid rgba(255, 255, 255, 0.28);
        box-shadow:
          0 22px 50px rgba(30, 10, 80, 0.45),
          inset 0 1px 0 rgba(255, 255, 255, 0.35);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
      }
      #global-loader .cl-card svg {
        width: 76px;
        height: auto;
        overflow: visible;
      }
      #global-loader .cl-track {
        fill: none;
        stroke: rgba(255, 255, 255, 0.22);
        stroke-width: 5;
        stroke-linecap: round;
      }
      #global-loader .cl-comet {
        fill: none;
        stroke: #fff;
        stroke-width: 5;
        stroke-linecap: round;
        stroke-dasharray: 22 28;
        filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.9));
        animation: cl-run 1.9s linear infinite;
      }
      @keyframes cl-run {
        to {
          stroke-dashoffset: -50;
        }
      }

      #global-loader .cl-name {
        margin: 28px 0 0;
        font-size: clamp(30px, 7vw, 40px);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.1;
      }
      #global-loader .cl-tag {
        margin: 6px 0 0;
        font-size: 15px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.78);
      }

      #global-loader .cl-msg {
        margin: 26px 0 0;
        min-height: 22px;
        font-size: 14px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.92);
      }
      #global-loader .cl-msg.cl-swap {
        animation: cl-in 0.4s ease both;
      }
      @keyframes cl-in {
        from {
          opacity: 0;
          transform: translateY(4px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      #global-loader .cl-bar {
        width: min(240px, 70vw);
        height: 4px;
        margin-top: 14px;
        border-radius: 99px;
        background: rgba(255, 255, 255, 0.2);
        overflow: hidden;
      }
      #global-loader .cl-fill {
        width: 0;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #fff, #ddd6fe);
        box-shadow: 0 0 12px rgba(255, 255, 255, 0.7);
        transition: width 0.35s ease;
      }

      #global-loader .cl-foot {
        position: absolute;
        left: 0;
        right: 0;
        bottom: calc(22px + env(safe-area-inset-bottom, 0px));
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.7);
        user-select: none;
      }
      #global-loader .cl-foot svg {
        width: 14px;
        height: 14px;
      }

      @media (max-width: 480px) {
        #global-loader .cl-card {
          width: 96px;
          height: 96px;
          border-radius: 26px;
        }
        #global-loader .cl-card svg {
          width: 64px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #global-loader .cl-comet {
          animation-duration: 6s;
        }
        #global-loader .cl-msg.cl-swap {
          animation: none;
        }
        #global-loader,
        #global-loader .cl-fill {
          transition-duration: 0.01s;
        }
      }
    </style>
    <noscript
      ><style>
        #global-loader {
          display: none !important;
        }
      </style></noscript
    >

    <div
      id="global-loader"
      role="status"
      aria-live="polite"
      aria-label="Loading ClassLoop"
    >
      <div class="cl-card" aria-hidden="true">
        <svg viewBox="0 0 100 50">
          <path
            class="cl-track"
            pathLength="100"
            d="M50 25C60 10 85 10 85 25S60 40 50 25 15 10 15 25 40 40 50 25Z"
          />
          <path
            class="cl-comet"
            pathLength="100"
            d="M50 25C60 10 85 10 85 25S60 40 50 25 15 10 15 25 40 40 50 25Z"
          />
        </svg>
      </div>

      <h1 class="cl-name">ClassLoop</h1>
      <p class="cl-tag">School management system</p>

      <p class="cl-msg" aria-hidden="true">Securing your session…</p>
      <div class="cl-bar" aria-hidden="true"><div class="cl-fill"></div></div>

      <div class="cl-foot" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="4" y="11" width="16" height="10" rx="2" />
          <path d="M8 11V7a4 4 0 0 1 8 0v4" />
        </svg>
        <span>Secure school portal</span>
      </div>
    </div>

    <script>
      (function () {
        var el = document.getElementById("global-loader");
        if (!el) return;

        var fill = el.querySelector(".cl-fill");
        var msg = el.querySelector(".cl-msg");
        var MIN_MS = 900; // shortest time the loader stays visible (avoids flicker)
        var MAX_MS = 20000; // failsafe: never trap the user behind the loader
        var MSGS = [
          "Securing your session…",
          "Loading attendance records…",
          "Syncing notices and fee data…",
          "Preparing your dashboard…",
        ];
        var reduce =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var root = document.documentElement;
        var prevOverflow = "",
          shownAt = Date.now(),
          pct = 0,
          idx = 0;
        var tick, rot, hideT, endT, failT;

        function paint(v) {
          pct = v;
          fill.style.width = v + "%";
        }
        function setMsg() {
          msg.textContent = MSGS[idx % MSGS.length];
          msg.classList.remove("cl-swap");
          void msg.offsetWidth;
          msg.classList.add("cl-swap");
        }
        function clearAll() {
          clearInterval(tick);
          clearInterval(rot);
          clearTimeout(hideT);
          clearTimeout(endT);
          clearTimeout(failT);
        }

        function show() {
          clearAll();
          shownAt = Date.now();
          idx = 0;
          el.style.display = "flex";
          void el.offsetWidth;
          el.classList.remove("is-hidden");
          if (root.style.overflow !== "hidden")
            prevOverflow = root.style.overflow;
          root.style.overflow = "hidden";
          fill.style.transition = "none";
          paint(0);
          void fill.offsetWidth;
          fill.style.transition = "";
          paint(8);
          setMsg();
          tick = setInterval(function () {
            paint(pct + (90 - pct) * 0.07);
          }, 250);
          if (!reduce)
            rot = setInterval(function () {
              idx++;
              setMsg();
            }, 1800);
          failT = setTimeout(hide, MAX_MS);
        }

        function hide() {
          var wait = Math.max(0, MIN_MS - (Date.now() - shownAt));
          clearTimeout(hideT);
          hideT = setTimeout(function () {
            clearInterval(tick);
            clearInterval(rot);
            clearTimeout(failT);
            paint(100);
            endT = setTimeout(function () {
              el.classList.add("is-hidden");
              root.style.overflow = prevOverflow;
              endT = setTimeout(function () {
                el.style.display = "none";
              }, 500);
            }, 300);
          }, wait);
        }

        // Manual control for route changes, big API calls, etc:
        //   ClassLoopLoader.show();  ...await work...  ClassLoopLoader.hide();
        window.ClassLoopLoader = { show: show, hide: hide };

        show();
        // Auto-hides when the page finishes loading.
        // For a single-page app, set data-autohide="false" on #global-loader and call
        // ClassLoopLoader.hide() yourself once your first data/route has rendered.
        if (el.getAttribute("data-autohide") !== "false") {
          if (document.readyState === "complete") hide();
          else window.addEventListener("load", hide);
        }
      })();
    </script>
    <!-- ===== ... to here ===== -->
  </body>
</html>
