<!-- Main Content Area -->
<main class="flex-1 flex flex-col overflow-hidden">
    <!-- Top Navigation Bar -->
    <header
        class="h-14 md:h-16 bg-white dark:bg-background-dark border-b border-slate-200 dark:border-slate-800 px-3 md:px-6 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3 md:gap-6 min-w-0 flex-1">
            <h2 class="text-base md:text-lg font-bold truncate">Welcome, <%= currUser.name%>
            </h2>
            <div class="hidden sm:flex items-center gap-2 px-3 py-1 bg-primary/10 rounded-full border border-primary/20 shrink-0">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                <span class="text-xs font-bold text-primary uppercase tracking-wide whitespace-nowrap">Class <%= currClass.className%>-<%=
                            currClass.section%></span>
            </div>
        </div>
        <div class="flex items-center gap-3 md:gap-4 shrink-0">
            
            <div
                class="h-9 w-9 md:h-10 md:w-10 rounded-xl overflow-hidden bg-slate-200 border-2 border-slate-100 dark:border-slate-800">
                <img alt="Profile" data-alt="Teacher professional profile headshot avatar"
                    src="<%= currUser.profilePic.url%>" />
            </div>
        </div>
    </header>
    
    <!-- Content Scrollable -->
    <div class="flex-1 overflow-y-auto p-3 md:p-6 space-y-6 md:space-y-8">
        <!-- Mobile Class Badge -->
        <div class="sm:hidden flex items-center justify-center">
            <div class="flex items-center gap-2 px-4 py-2 bg-primary/10 rounded-full border border-primary/20">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                <span class="text-xs font-bold text-primary uppercase tracking-wide">Class <%= currClass.className%>-<%= currClass.section%></span>
            </div>
        </div>

        <!-- Stats / Metrics Section -->
<section class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
    
    <!-- 1. Strength of the Class -->
<a href="/teacher?tab=Students" class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 p-4 md:p-6 rounded-xl hover:shadow-md transition-shadow">
    <div class="flex items-center justify-between mb-2">
        <span class="text-slate-500 text-xs md:text-sm font-medium">Class Strength</span>
        <span class="material-symbols-outlined text-indigo-500 text-xl md:text-2xl">diversity_3</span>
    </div>
    <div class="flex items-baseline gap-2">
        <h3 class="text-2xl md:text-3xl font-bold">
            <%= (currClass && currClass.students) ? currClass.students.length : 0 %>
        </h3>
        <span class="text-[10px] md:text-xs text-slate-400">Enrolled</span>
    </div>
</a>

    <!-- 2. Today's Attendance -->
    <a href="/teacher?tab=Attendance" class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 p-4 md:p-6 rounded-xl hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between mb-2">
            <span class="text-slate-500 text-xs md:text-sm font-medium">Today's Attendance</span>
            <span class="material-symbols-outlined text-primary text-xl md:text-2xl">groups</span>
        </div>
        <div class="flex items-baseline gap-2">
            <h3 class="text-2xl md:text-3xl font-bold">
                <%= isMarked ? `${attendancePercent}%` : '0%' %>
            </h3>
            <span class="text-[10px] md:text-xs font-bold <%= isMarked ? 'text-emerald-500' : 'text-slate-400' %> flex items-center">
                <%= isMarked ? 'Completed' : 'Pending' %>
                <span class="material-symbols-outlined text-xs ml-1">
                    <%= isMarked ? 'check_circle' : 'pending' %>
                </span>
            </span>
        </div>
    </a>

    <!-- 3. Total Assignments -->
    <a href="/teacher?tab=Assignments" class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 p-4 md:p-6 rounded-xl hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between mb-2">
            <span class="text-slate-500 text-xs md:text-sm font-medium">Class Assignments</span>
            <span class="material-symbols-outlined text-amber-500 text-xl md:text-2xl">assignment</span>
        </div>
        <div class="flex items-baseline gap-2">
            <h3 class="text-2xl md:text-3xl font-bold"><%= assignments.length %></h3>
            <span class="text-[10px] md:text-xs text-slate-400">Active Tasks</span>
        </div>
    </a>

    <!-- 4. Pending Applications -->
    <a href="/teacher?tab=Applications" class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 p-4 md:p-6 rounded-xl hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between mb-2">
            <span class="text-slate-500 text-xs md:text-sm font-medium">Pending Apps</span>
            <span class="material-symbols-outlined text-rose-500 text-xl md:text-2xl">mark_email_unread</span>
        </div>
        <div class="flex items-baseline gap-2">
            <h3 class="text-2xl md:text-3xl font-bold"><%= pendingApps %></h3>
            <span class="text-[10px] md:text-xs text-rose-500 font-bold flex items-center">Action Required</span>
        </div>
    </a>

    <!-- 5. Current Status (Sample Class) -->
    <a href="/teacher?tab=Timetable" class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 p-4 md:p-6 rounded-xl hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between mb-2">
            <span class="text-slate-500 text-xs md:text-sm font-medium">Ongoing Class</span>
            <span class="material-symbols-outlined text-emerald-500 text-xl md:text-2xl">play_circle</span>
        </div>
        <div class="flex flex-col mt-1">
            <h3 class="text-sm md:text-base font-bold text-slate-800 dark:text-white truncate">B.Tech CSE - 3rd Year</h3>
            <span class="text-[10px] md:text-xs font-bold text-emerald-500 flex items-center mt-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                Room 402 • Live
            </span>
        </div>
    </a>

</section>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 md:gap-8">
            <!-- Middle Column: Feed -->
            <div class="xl:col-span-2 space-y-4 md:space-y-6">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg md:text-xl font-bold">Add a Notice</h3>
                    <div class="flex gap-2">
                        <button class="p-2 text-slate-500 hover:bg-slate-100 rounded-lg"><span
                                class="material-symbols-outlined text-xl">filter_list</span></button>
                    </div>
                </div>
                <form action="/teacher/addNotice" method="POST"
                    class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm"
                    method="POST">
                    <div class="p-4 md:p-5 space-y-4">
                        <div class="flex gap-3 md:gap-4">
                            <img class="w-9 h-9 md:w-10 md:h-10 rounded-full shrink-0" data-alt="Small circular teacher avatar icon"
                                src="<%=currUser.profilePic.url%>" />
                            <div class="flex-1 space-y-3 md:space-y-4 min-w-0">
                                <div>
                                    <input
                                        class="w-full bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg px-3 md:px-4 py-2 md:py-2.5 text-xs md:text-sm font-semibold focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all placeholder:text-slate-400"
                                        name="title" placeholder="Notice Title (e.g., Upcoming Field Trip)" required=""
                                        type="text" />
                                </div>
                                <textarea
                                    class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900/30 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent text-xs md:text-sm text-slate-700 dark:text-slate-300 placeholder:text-slate-400 resize-none p-3 md:p-4"
                                    name="content" placeholder="Write the content of your notice here..." required=""
                                    rows="3"></textarea>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
                                    <div class="space-y-1.5">
                                        <label
                                            class="text-[9px] md:text-[10px] uppercase font-bold text-slate-500 tracking-wider flex items-center gap-1">
                                            <span class="material-symbols-outlined text-xs md:text-sm">groups</span> Audience
                                        </label>
                                        <select
                                            class="w-full bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700 rounded-lg text-[11px] md:text-xs font-medium focus:ring-primary transition-all py-2"
                                            name="audience">
                                            <option value="all">All Members</option>
                                            <option value="teachers">Teachers Only</option>
                                            <option value="students">Students Only</option>
                                            <option value="specific_class">Specific Class (10-A)</option>
                                        </select>
                                    </div>
                                    <div class="space-y-1.5">
                                        <label
                                            class="text-[9px] md:text-[10px] uppercase font-bold text-slate-500 tracking-wider flex items-center gap-1">
                                            <span class="material-symbols-outlined text-xs md:text-sm">priority_high</span>
                                            Priority
                                        </label>
                                        <div class="relative">
                                            <select
                                                class="w-full bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700 rounded-lg text-[11px] md:text-xs font-medium focus:ring-primary transition-all appearance-none py-2"
                                                name="priority">
                                                <option value="low">Low Priority</option>
                                                <option value="medium">Medium Priority</option>
                                                <option value="high">High Priority</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div
                                    class="flex items-center justify-between mt-4 md:mt-6 pt-3 md:pt-4 border-t border-slate-100 dark:border-slate-800">
                                    
                                    <button
                                        class="w-full sm:w-auto px-6 md:px-8 py-2 md:py-2.5 bg-primary text-white text-xs md:text-sm font-bold rounded-xl hover:bg-primary/90 transition-all shadow-md active:scale-95"
                                        type="submit">Post Notice</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                
                <div class="space-y-4 mt-6 md:mt-8">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold flex items-center gap-2 text-slate-900 dark:text-white">
            Recent Notices
            <% if (notices && notices.length > 0) { %>
                <span class="bg-indigo-500 text-white text-[9px] md:text-[10px] font-bold px-2 py-0.5 rounded-full">
                    <%= notices.length %>
                </span>
            <% } %>
        </h3>
    </div>

    <!-- Notices List -->
    <% if (notices && notices.length > 0) { %>
        <div class="space-y-3">
            <% notices.forEach(function(notice) { %>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3 md:p-4 bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm hover:shadow-md transition-shadow gap-3 sm:gap-4">
                    
                    <!-- Left: Author Profile Pic & Notice Info -->
                    <div class="flex items-start gap-3 md:gap-4 min-w-0 flex-1">
                        <img 
                            class="w-9 h-9 md:w-10 md:h-10 rounded-full object-cover border border-slate-200 dark:border-slate-700 bg-slate-100 shrink-0 mt-0.5 sm:mt-0" 
                            alt="Author Avatar" 
                            src="<%= (notice.author && notice.author.profilePic && notice.author.profilePic.url) ? notice.author.profilePic.url : 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_1280.png' %>" 
                        />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <h4 class="text-xs md:text-sm font-bold text-slate-900 dark:text-white truncate">
                                    <%= notice.title %>
                                </h4>
                                <% if (notice.createdAt) { %>
                                    <span class="text-[10px] text-slate-400 dark:text-slate-500 shrink-0">
                                        • <%= new Date(notice.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                    </span>
                                <% } %>
                            </div>

                            <% if (notice.content || notice.message) { %>
                                <p class="text-xs text-slate-600 dark:text-slate-300 font-normal line-clamp-2 mt-0.5">
                                    <%= notice.content || notice.message %>
                                </p>
                            <% } %>

                            <p class="text-[10px] md:text-xs text-slate-400 dark:text-slate-500 font-medium mt-1">
                                Posted by <span class="font-semibold text-slate-700 dark:text-slate-300"><%= notice.author ? notice.author.name : 'System' %></span>
                            </p>
                        </div>
                    </div>

                    <!-- Right: Delete Action -->
                    <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
                        <form action="/teacher/notice/delete" method="POST" class="m-0" onsubmit="return confirm('Are you sure you want to delete this notice?');">
                            <input type="hidden" name="noticeId" value="<%= notice._id %>">
                            <button type="submit" title="Delete Notice" class="w-8 h-8 flex items-center justify-center bg-rose-50 text-rose-600 hover:bg-rose-500 hover:text-white dark:bg-rose-500/10 dark:text-rose-400 dark:hover:bg-rose-500 dark:hover:text-white rounded-lg transition-colors shrink-0">
                                <span class="material-symbols-outlined text-sm font-bold">delete</span>
                            </button>
                        </form>
                    </div>

                </div>
            <% }) %>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center p-6 md:p-8 bg-slate-50 dark:bg-slate-900/30 border border-slate-200 dark:border-slate-800 border-dashed rounded-xl text-center">
            <div class="w-10 h-10 md:w-12 md:h-12 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mb-3">
                <span class="material-symbols-outlined text-slate-400 dark:text-slate-500 text-lg md:text-xl">campaign</span>
            </div>
            <h4 class="text-xs md:text-sm font-bold text-slate-700 dark:text-slate-300">No Recent Notices</h4>
            <p class="text-[10px] md:text-xs text-slate-500 dark:text-slate-500 mt-1 max-w-[200px]">
                Notices created for this class or school will appear here.
            </p>
        </div>
    <% } %>
</div>
            </div>
            
            <!-- Right Column: My Classes -->
<div class="space-y-4 md:space-y-6">
    <div
        class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 rounded-xl p-4 md:p-5 shadow-sm space-y-3 md:space-y-4">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-xl">add_circle</span>
            <h4 class="text-xs md:text-sm font-bold">Register New Subject</h4>
        </div>
        <form action="/teacher/addSubject" class="space-y-3" method="POST">
            <div>
                <input
                    class="w-full px-3 md:px-4 py-2 bg-slate-100 dark:bg-slate-800 border-none rounded-xl text-xs md:text-sm placeholder:text-slate-400 focus:ring-2 focus:ring-primary"
                    name="subjectName" placeholder="Subject Name" type="text" required />
            </div>
            <div>
                <select
                    class="w-full px-3 md:px-4 py-2 bg-slate-100 dark:bg-slate-800 border-none rounded-xl text-xs md:text-sm text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary outline-none"
                    name="teacherId" required>
                    <option value="" disabled selected>Select Teacher to Assign</option>
                    <% if (currSchool && currSchool.teachers && currSchool.teachers.length > 0) { %>
                        <% for (let teacher of currSchool.teachers) { %>
                            <option value="<%= teacher._id %>">
                                Prof. <%= teacher.name %>
                            </option>
                        <% } %>
                    <% } else { %>
                        <option value="" disabled>No teachers available</option>
                    <% } %>
                </select>
            </div>
            <button
                class="w-full py-2 md:py-2.5 bg-primary text-white text-xs md:text-sm font-bold rounded-xl hover:bg-primary/90 transition-all flex items-center justify-center gap-2"
                type="submit">
                <span class="material-symbols-outlined text-base md:text-lg">add</span>
                Add Subject
            </button>
        </form>
    </div>
    
    <div class="flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold">My Assigned Classes</h3>
    </div>
    
    <div
        class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 rounded-xl divide-y divide-slate-100 dark:divide-slate-800 overflow-hidden shadow-sm">
        <% for(let Subject of currClass.subjects) { %>
            <div class="p-3 md:p-4 bg-primary/5 hover:bg-primary/10 transition-colors">
                <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0 flex-1">
                        <h4 class="text-xs md:text-sm font-bold text-slate-900 dark:text-white truncate">
                            <%=Subject.name %>
                        </h4>
                        <p class="text-[10px] md:text-xs text-primary font-semibold mt-0.5">Class <%=currClass.className%>-<%=currClass.section%>
                        </p>
                    </div>
                    <span
                        class="px-2 py-0.5 bg-emerald-100 text-emerald-600 text-[9px] md:text-[10px] font-bold rounded uppercase shrink-0">Active</span>
                </div>
                <div class="flex items-center gap-2 mt-3 md:mt-4">
                    <img class="w-5 h-5 md:w-6 md:h-6 rounded-full border border-slate-200 shrink-0"
                        data-alt="Small teacher avatar" src="<%=Subject.teacher ? Subject.teacher.profilePic?.url : ''%>" />
                    <span class="text-[10px] md:text-xs text-slate-600 dark:text-slate-400 font-medium truncate">Prof.
                        <%=Subject.teacher ? Subject.teacher.name : 'Unassigned'%>
                    </span>
                </div>
            </div>
        <% } %>
    </div>
</div>
        </div>
    </div>
</main>
